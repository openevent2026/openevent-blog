---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>OpenEvent Blog</title>
    <description>Event-driven, log-first Agent framework notes from OpenEvent.</description>
    <link>{{ '/en/' | absolute_url }}</link>
    <atom:link href="{{ '/feed-en.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    <language>en</language>
    {% assign posts = site.posts | where: "lang", "en" %}
    {% for post in posts limit: 20 %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <description>{{ post.description | default: post.excerpt | strip_html | xml_escape }}</description>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <link>{{ post.url | absolute_url }}</link>
        <guid>{{ post.url | absolute_url }}</guid>
      </item>
    {% endfor %}
  </channel>
</rss>
